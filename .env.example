# ---- MikroTik Manager: minimalna konfiguracja ----
# Reszta ustawien (podsiec WG, adres huba, admin) idzie przez KREATOR w przegladarce
# przy pierwszym uruchomieniu. Sekrety (klucz szyfrowania, token agenta, certyfikat
# HTTPS) portal generuje sam — nie ma tu zadnych hasel do wymyslania.

# Port WireGuarda (UDP) — JEDYNY publikowany na swiat. Wybierz wysoki, nietypowy;
# zmiana po wdrozeniu floty odlacza urzadzenia, wiec ustaw go raz na starcie.
WG_PORT=51820

# Port panelu (HTTPS) i adres, na ktorym ma nasluchiwac.
# 0.0.0.0 publikuje panel na WSZYSTKICH interfejsach hosta — potrzebne do kreatora przy
# pierwszym uruchomieniu (kreator i tak wymaga tokenu z logow). Na hoscie z publicznym
# adresem ogranicz go: firewallem chmury albo regula w DOCKER-USER (Docker omija INPUT!),
# a po zalozeniu portalu najlepiej CADDY_BIND=127.0.0.1 — dostep zostaje przez tunel.
CADDY_PORT=8443
CADDY_BIND=0.0.0.0

# Adres/domena, pod ktora urzadzenia beda sie laczyc do huba. Trafia do generowanych
# skryptow RouterOS. Mozna tez ustawic pozniej w kreatorze.
HUB_ENDPOINT=

# Baza danych — zmien haslo przed uruchomieniem.
POSTGRES_USER=mtm
POSTGRES_PASSWORD=zmien-to-haslo
POSTGRES_DB=mtm

# Wersja obrazow. Przypnij do konkretnej zamiast `latest`.
MTM_VERSION=latest
