# WireGuard (wg-mt)
WG_INTERFACE=wg-mt
WG_PORT=62693
WG_SERVER_IP=
# Podsiec i adres huba w tunelu USTAWIA KREATOR pierwszego uruchomienia i zapisuje
# je w bazie. Zostaw puste na swiezej instalacji — sa tu tylko po to, zeby istniejace
# wdrozenia mogly zaseedowac wartosci z .env do bazy przy pierwszym starcie.
WG_SUBNET=
# Klucz publiczny serwera wg-mt (patrz logi kontenera wireguard po pierwszym starcie:
# `docker compose logs wireguard` -> "Server public key: ...")
WG_SERVER_PUBLIC_KEY=changeme
# Adres, pod którym MikroTiki wybiją tunel do huba (LAN hosta w labie)
HUB_ENDPOINT=changeme
# Token współdzielony backend <-> control-channel w kontenerze wireguard (dowolny losowy string)
WG_AGENT_TOKEN=changeme

# PostgreSQL
POSTGRES_USER=mtm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mikrotik_manager

# Backend — sekrety aplikacyjne
# UWAGA: te trzy są OPCJONALNE. Przy pierwszym starcie backend generuje je sam na
# wolumenie /data/secrets, jeśli tu ich nie ma. Zostaw puste/usuń dla świeżej
# instalacji. Wpisz wartość tylko przy ręcznej migracji istniejącego stacku
# (zostanie jednorazowo zaseedowana na wolumen, potem można usunąć).
# FERNET_KEY=
# SESSION_SECRET=
# Co ile sekund scheduler odpytuje urządzenia (handshake WG + REST API)
POLL_INTERVAL_SECONDS=60

# Kopie zapasowe (push przez /tool fetch -> wbudowany serwer SFTP w backendzie,
# osiągalny tylko przez tunel wg-mt, DNAT w kontenerze wireguard)
# BACKUP_SFTP_PASSWORD jest OPCJONALNE — generowane samo na wolumenie przy 1. starcie
# (patrz sekcja sekretów wyżej). Zostaw puste dla świeżej instalacji.
# BACKUP_SFTP_PASSWORD=
BACKUP_SFTP_PORT=2222
# Port odbiornika syslog (UDP). Osiagalny WYLACZNIE przez tunel (DNAT w kontenerze
# wireguard), nigdzie nie publikowany na hosta. Routery dostaja go od portalu przez
# API, wiec nie musi byc systemowym 514.
SYSLOG_PORT=5514
# Ile sekund czekać na dotarcie pliku po wywołaniu /tool fetch, zanim uznamy kopię za nieudaną
BACKUP_UPLOAD_TIMEOUT_SECONDS=120

# Panel (Caddy)
CADDY_BIND=0.0.0.0
CADDY_PORT=8443
